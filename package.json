{
  "name": "tasklock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:single": "cross-env SINGLEFILE=1 vite build",
    "embed": "node launcher/embed.cjs",
    "build:exe": "npm run build:single && npm run embed && bun build launcher/server.cjs --compile --outfile release/tasklock",
    "start:launcher": "node launcher/server.cjs"
  },
  "bin": "launcher/server.cjs",
  "dependencies": {
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
